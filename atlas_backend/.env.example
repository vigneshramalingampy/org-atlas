ENVIRONMENT=dev
HOST=localhost
PORT=8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=atlas-documents

SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_NAMESPACE=atlas
SURREALDB_DATABASE=knowledge

CHUNKING_STRATEGY=recursive
CHUNK_MAX_SIZE=512
CHUNK_MIN_SIZE=100
CHUNK_PARENT_SIZE=1024
CHUNK_OVERLAP=0

EMBEDDING_PROVIDER=sentence-transformer-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

GRAPH_EXTRACTION_ENABLED=false
GRAPH_LLM_PROVIDER=ollama

CHAT_LLM_PROVIDER=ollama
CHAT_MODEL=llama3.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=1024
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0

MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf","docx","html","md"]
